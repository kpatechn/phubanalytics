# Copy to .env (never commit it). scripts/write-dev-env.sh fills this from your libpq service entry.
# Analytics rollups (Graton dev dexl). Optional: unset hides the executive, engagement, marketing and IT views.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/dexl
DATABASE_SSL=require

# Optional Chickasaw CDP (GEM database dexiga, schema cdp). Leave unset to hide the CDP.
# GEM_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/dexiga
# GEM_DATABASE_SSL=disable
# CDP_CLIENT_NAME=Chickasaw

# Optional Reinvestment: the data platform's serving database (Aurora, RDS Data API) and the
# optimizer Lambda. Both ARNs come from the reverse ETL Lambda's CLUSTER_ARN / SECRET_ARN.
# Leave unset to hide Reinvestment. Credentials come from the AWS default chain.
# SERVING_CLUSTER_ARN=arn:aws:rds:us-west-2:<account>:cluster:playerhub-dev-serving
# SERVING_SECRET_ARN=arn:aws:secretsmanager:us-west-2:<account>:secret:...
# SERVING_DATABASE=serving
# REINVESTMENT_TENANT=chickasaw_sim
# OPTIMIZER_FUNCTION=playerhub-dev-optimizer
# AWS_REGION=us-west-2
# AWS_PROFILE=playerhub-dev

APP_ENVIRONMENT=dev

# jwt: verify Bearer tokens against JWT_JWKS_URL. dev: every request is analytics:admin (dev only).
AUTH_MODE=dev
# JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# JWT_ISSUER=https://idp.example.com/
# JWT_AUDIENCE=playerhub-analytics
# JWT_ROLES_CLAIM=roles

# Behind the AWS load balancer with Cognito (infra/terraform/dashboard in the data platform):
# JWT_TOKEN_HEADER=x-amzn-oidc-accesstoken
# JWT_CLIENT_ID=<Cognito app client id>
# JWT_ROLES_CLAIM=cognito:groups
# JWT_SUBJECT_CLAIM=username
# Serve the built web app from this server (the container sets WEB_ROOT=/app/web).
# WEB_ROOT=../web/dist/web/browser

# Only when the web app is served from another origin.
# ALLOWED_ORIGIN=https://analytics.example.com

PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
